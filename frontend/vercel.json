{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://stateracs-production.up.railway.app/api/:path*"
    },
    {
      "source": "/trade/:token",
      "destination": "https://stateracs-production.up.railway.app/trade/:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}